[Unit]
Description=MLBB Smile Coins Telegram bot (polling mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/mlbb-smile-coins-bot
EnvironmentFile=/home/ubuntu/mlbb-smile-coins-bot/.env
ExecStart=/usr/bin/python3 /home/ubuntu/mlbb-smile-coins-bot/poll_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
